{
  "collectionName": "components_shared_process_sections",
  "info": {
    "displayName": "Process Section",
    "description": "Editorial process block with repeatable steps"
  },
  "attributes": {
    "sectionTitle": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "component",
      "repeatable": false,
      "component": "shared.image-asset"
    },
    "steps": {
      "type": "component",
      "repeatable": true,
      "component": "shared.process-step"
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
