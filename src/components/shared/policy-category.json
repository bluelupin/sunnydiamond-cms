{
  "collectionName": "components_shared_policy_categories",
  "info": {
    "displayName": "Policy Category",
    "description": "A sidebar group containing an ordered set of policies"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "policies": {
      "type": "component",
      "repeatable": true,
      "component": "shared.policy-entry",
      "required": true
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
