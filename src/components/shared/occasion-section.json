{
  "collectionName": "components_shared_occasion_sections",
  "info": {
    "displayName": "Occasion Section",
    "description": "Homepage occasion block with reusable occasion records"
  },
  "attributes": {
    "sectionTitle": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "component",
      "repeatable": false,
      "component": "shared.image-asset"
    },
    "occasions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::occasion.occasion"
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
