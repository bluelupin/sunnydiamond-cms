{
  "collectionName": "components_shared_link_items",
  "info": {
    "displayName": "Link Item",
    "description": "Navigation or footer link"
  },
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "targetType": {
      "type": "enumeration",
      "enum": [
        "internal",
        "external",
        "magento"
      ],
      "default": "internal"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
