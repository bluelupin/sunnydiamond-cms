{
  "collectionName": "components_shared_policy_accordion_items",
  "info": {
    "displayName": "Policy Accordion Item",
    "description": "A collapsible question and answer within a policy"
  },
  "options": {},
  "attributes": {
    "question": {
      "type": "string",
      "required": true
    },
    "answer": {
      "type": "customField",
      "customField": "plugin::ckeditor.CKEditor",
      "options": {
        "output": "HTML",
        "preset": "standard"
      },
      "required": true
    },
    "isOpenByDefault": {
      "type": "boolean",
      "default": false
    }
  }
}
