{
  "collectionName": "components_shared_collection_showcase_sections",
  "info": {
    "displayName": "Collection Showcase Section",
    "description": "Editorial collection showcase with CMS images and commerce references"
  },
  "attributes": {
    "sectionTitle": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "primaryImage": {
      "type": "component",
      "component": "shared.image-asset",
      "repeatable": false
    },
    "collection": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::editorial-collection.editorial-collection"
    },
    "magentoCollectionRef": {
      "type": "string"
    },
    "cta": {
      "type": "component",
      "component": "shared.cta",
      "repeatable": false
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "showField": {
      "type": "boolean",
      "default": true
    }
  }
}
