{
  "kind": "collectionType",
  "collectionName": "product_forms",
  "info": {
    "singularName": "product-form",
    "pluralName": "product-forms",
    "displayName": "Builder: Product Forms"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "formName": { "type": "string", "required": true },
    "formTag": { "type": "uid", "targetField": "formName", "required": true },
    "submitButtonText": { "type": "string", "default": "SUBMIT" },
    "isMultiStep": { "type": "boolean", "default": false },
    "stepOneButtonText": { "type": "string", "default": "ADD ADDRESS" },
    "allowImageUpload": { "type": "boolean", "default": false },
    "stateOptions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::state.state"
    },
    "availableTimeSlots": {
      "type": "component",
      "repeatable": true,
      "component": "shared.time-slot"
    },
    "dynamicFields": {
      "type": "component",
      "repeatable": true,
      "component": "shared.form-field"
    }
  }
}