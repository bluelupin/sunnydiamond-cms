{
  "kind": "collectionType",
  "collectionName": "editorial_collections",
  "info": {
    "singularName": "editorial-collection",
    "pluralName": "editorial-collections",
    "displayName": "Editorial Collection"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "collectionName": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "collectionName",
      "required": true
    },
    "description": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "backgroundImage": {
      "type": "component",
      "repeatable": false,
      "component": "shared.image-asset",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "featuredProductSku": {
      "type": "string"
    },
    "productSkus": {
      "type": "component",
      "repeatable": true,
      "component": "shared.product-sku"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true
    }
  }
}
