{
  "kind": "collectionType",
  "collectionName": "news_articles",
  "info": { "singularName": "news-article", "pluralName": "news-articles", "displayName": "News Article" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "excerpt": { "type": "text" },
    "body": { "type": "richtext" },
    "sourceName": { "type": "string" },
    "sourceUrl": { "type": "string" },
    "publishedDate": { "type": "date" },
    "featuredImage": { "type": "component", "repeatable": false, "component": "shared.image-asset" },
    "isFeatured": { "type": "boolean", "default": false },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
