{
  "kind": "collectionType",
  "collectionName": "generic_submissions",
  "info": {
    "singularName": "generic-submission",
    "pluralName": "generic-submissions",
    "displayName": "Submissions: General Queries"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "formTag": {
      "type": "string",
      "required": true
    },
    "fullName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string"
    },
    "preferredShowroom": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::showroom.showroom"
    },
    "preferredDate": {
      "type": "date"
    },
    "selectedTimeSlot": {
      "type": "string"
    },
    "notes": {
      "type": "text"
    },
    "reasonForContact": {
      "type": "string"
    },
    "sourcePage": {
      "type": "string"
    },
    "consentAccepted": {
      "type": "boolean",
      "default": false
    },
    "internalNotes": {
      "type": "text"
    },
    "workflowStatus": {
      "type": "enumeration",
      "default": "New",
      "enum": [
        "New",
        "Contacted",
        "Scheduled",
        "Visited",
        "Closed",
        "Cancelled"
      ]
    },
    "magentoCustomerId": {
      "type": "integer",
      "private": true
    },
    "appointmentReference": {
      "type": "string",
      "private": true
    },
    "rescheduleHistory": {
      "type": "json",
      "private": true
    },
    "appointmentChanges": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::appointment-change.appointment-change",
      "mappedBy": "affectedGenericSubmissions",
      "private": true
    }
  }
}
