{
  "kind": "singleType",
  "collectionName": "store_locator_pages",
  "info": {
    "singularName": "store-locator-page",
    "pluralName": "store-locator-pages",
    "displayName": "Store Locator Page",
    "description": "Page content and showroom records for the store locator"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.hero-section",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "searchPlaceholder": {
      "type": "string",
      "default": "Enter a location or pincode",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "useCurrentLocationLabel": {
      "type": "string",
      "default": "Use Current Location",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "locationFilters": {
      "type": "component",
      "repeatable": true,
      "component": "shared.store-location-filter",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "getDirectionsLabel": {
      "type": "string",
      "default": "Get Directions",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "noResultsMessage": {
      "type": "text",
      "default": "No stores found for this location.",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "showrooms": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::showroom.showroom"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
