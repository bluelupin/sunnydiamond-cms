{
  "kind": "collectionType",
  "collectionName": "support_pages",
  "info": { "singularName": "support-page", "pluralName": "support-pages", "displayName": "Support Page" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "hero": { "type": "component", "repeatable": false, "component": "shared.hero-section" },
    "body": { "type": "richtext" },
    "links": { "type": "component", "repeatable": true, "component": "shared.link-item" },
    "sortOrder": { "type": "integer", "default": 0 },
    "isActive": { "type": "boolean", "default": true },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
