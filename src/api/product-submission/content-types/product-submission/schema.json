{
  "kind": "collectionType",
  "collectionName": "product_submissions",
  "info": {
    "singularName": "product-submission",
    "pluralName": "product-submissions",
    "displayName": "Submissions: Product"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "formTag": { "type": "string", "required": true },
    "productName": { "type": "string", "required": true },
    "productId": { "type": "string" },
    "customerName": { "type": "string", "required": true },
    "customerPhone": { "type": "string", "required": true },
    "customerEmail": { "type": "email" },
    "magentoCustomerId": { "type": "integer", "private": true },
    "requestedDate": { "type": "date" },
    "selectedTimeSlot": { "type": "string" },
    "requestDetails": { "type": "text" },
    "addressLine1": { "type": "string" },
    "addressLine2": { "type": "string" },
    "pincode": { "type": "string" },
    "city": { "type": "string" },
    "state": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::state.state"
    },
    "preferredShowroom": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::showroom.showroom"
    },
    "sourcePage": { "type": "string" },
    "utmSource": { "type": "string" },
    "utmMedium": { "type": "string" },
    "utmCampaign": { "type": "string" },
    "consentAccepted": { "type": "boolean", "default": false },
    "internalNotes": { "type": "text" },
    "uploadedImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "workflowStatus": {
      "type": "enumeration",
      "default": "New",
      "enum": ["New", "Contacted", "Scheduled", "Visited", "Closed"]
    }
  }
}
