{
  "kind": "singleType",
  "collectionName": "contact_pages",
  "info": {
    "singularName": "contact-page",
    "pluralName": "contact-pages",
    "displayName": "Contact Us Page",
    "description": "Section-wise content for the Contact Us page"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "heroSection": {
      "type": "component",
      "repeatable": false,
      "component": "shared.hero-section",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "introText": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "contactSection": {
      "type": "component",
      "repeatable": false,
      "component": "shared.contact-support-section",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "formSection": {
      "type": "component",
      "repeatable": false,
      "component": "shared.generic-form-section",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "visitSection": {
      "type": "component",
      "repeatable": false,
      "component": "shared.showroom-section",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
