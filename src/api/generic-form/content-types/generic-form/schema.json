{
  "kind": "collectionType",
  "collectionName": "generic_forms",
  "info": {
    "singularName": "generic-form",
    "pluralName": "generic-forms",
    "displayName": "Builder: Generic Forms"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "formName": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "formTag": {
      "type": "uid",
      "targetField": "formName",
      "required": true
    },
    "submitButtonText": {
      "type": "string",
      "default": "SUBMIT",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "availableTimeSlots": {
      "type": "component",
      "repeatable": true,
      "component": "shared.time-slot"
    },
    "dynamicFields": {
      "type": "component",
      "repeatable": true,
      "component": "shared.form-field",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "showrooms": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::showroom.showroom"
    }
  }
}
