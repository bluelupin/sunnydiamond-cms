HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Set true to update existing CMS single types when seed content changes.
CMS_SEED_UPSERT=false

# Optional Next.js ISR/tag revalidation webhook.
# Example: https://www.example.com/api/revalidate
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=
FRONTEND_REVALIDATE_ENABLED=true

# AWS S3 upload provider with CloudFront CDN delivery
# Max upload size in bytes. Default is 25MB.
UPLOAD_MAX_FILE_SIZE=26214400
UPLOAD_PROVIDER=
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_REGION=
AWS_BUCKET=
AWS_ACL=public-read
AWS_SIGNED_URL_EXPIRES=900
CDN_URL=
CDN_ROOT_PATH=

# Set it true to migrate old homepage content to new homepage structure. This will only run once and then be disabled.
MIGRATE_HOMEPAGE=