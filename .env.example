HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
CKEDITOR_LICENSE_KEY=

# Set true to update existing CMS single types when seed content changes.
CMS_SEED_UPSERT=false
CMS_SEED_ENABLED=false

# Seed and publish career openings on Strapi startup. Disable after one successful run.
CAREER_OPENING_SEED_ENABLED=false

# Optional Next.js ISR/tag revalidation webhook.
# Example: https://www.example.com/api/revalidate
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=
FRONTEND_REVALIDATE_ENABLED=true

# AWS S3 upload provider with CloudFront CDN delivery
# Max upload size in bytes. Default is 25MB.
UPLOAD_MAX_FILE_SIZE=26214400
# Resume autofill. Only locally extracted text is sent to OpenAI.
RESUME_PARSER_ENABLED=false
OPENAI_API_KEY=
OPENAI_RESUME_MODEL=gpt-4.1-mini
UPLOAD_PROVIDER=
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_REGION=
AWS_BUCKET=
AWS_ACL=public-read
AWS_SIGNED_URL_EXPIRES=900
CDN_URL=
CDN_ROOT_PATH=

# Set it true to migrate old homepage content to new homepage structure. This will only run once and then be disabled.
MIGRATE_HOMEPAGE=
MIGRATE_GRADE_STOP_IMAGES=false
MIGRATE_GRADE_STOP_IMAGES_DRY_RUN=true

# Magento customer-token validation.
MAGENTO_BASE_URL=
MAGENTO_STORE_CODE=default
MAGENTO_CUSTOMER_REQUEST_TIMEOUT_MS=5000

# Gmail API OAuth credentials (never commit real values).
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
GOOGLE_MAIL_REFRESH_TOKEN=
EMAIL_FROM="Sunny Diamonds News Letters <mailer@mailer.sunnydiamonds.com>"
EMAIL_REPLY_TO=customerservice@sunnydiamonds.com
# Frontend page used by the confirmation email. The submission documentId is added as a query parameter.
APPOINTMENT_MANAGE_URL=
# Website origin used to resolve relative sourcePage links in appointment emails.
WEB_BASE_URL=https://www.sunnydiamonds.com
# Staff inbox for "piece added" emails on video calls (store visits use the showroom email).
APPOINTMENT_STAFF_EMAIL=
